RewriteEngine On

# La carpeta /courses contiene imágenes, pero /courses es también una ruta React.
# Esta excepción debe ir antes de la condición que excluye directorios físicos.
RewriteRule ^courses/?$ index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Fingerprinted build assets are immutable; models/previews can be revalidated daily.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(glb|hdr|webp|png|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
